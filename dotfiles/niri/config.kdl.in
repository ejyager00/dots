// niri config.  Generated by Guix Home from dotfiles/niri/config.kdl.in:
// tokens of the form at-sign brace NAME brace are substituted with absolute
// store paths at build time (substituted-file in (ejyager00 home template)),
// so startup never depends on PATH.  Read `man 5 niri` / the niri wiki for
// the full reference.  niri reloads this file live on change.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    // sway's default; doesn't scroll the view to reach a partly offscreen
    // column just because the pointer crossed it.
    focus-follows-mouse max-scroll-amount="0%"
}

// Same layout as dotfiles/kanshi/config (Dell left, Acer right), identified
// by EDID "make model serial" so connector renumbering doesn't matter.
// Refresh pinned to 60 like kanshi: unpinned, niri picks the highest mode,
// and the Acer's 100 Hz mode leaves it blank.
output "Dell Inc. DELL SE2219H 650T043" {
    mode "1920x1080@60.000"
    scale 1
    position x=0 y=0
}
output "Acer Technologies KB272 E 34030B5623W01" {
    mode "1920x1080@60.000"
    scale 1
    position x=1920 y=0
}

layout {
    // Workspaces paint an opaque gray by default, hiding the backdrop that
    // noctalia's wallpaper is placed in (see the layer-rule below).
    background-color "transparent"
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
    }
}

// Ask clients to drop their own titlebars, as sway's tiling does.
prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

// Matches the sway Mod+Shift+Print path.  niri also copies every screenshot
// to the clipboard.
screenshot-path "~/Images/%Y-%m-%d_%H-%M-%S.png"

// X11 apps: niri sets DISPLAY and starts the satellite on the first X client.
xwayland-satellite {
    path "@{xwayland-satellite}"
}

// Keep noctalia's wallpaper visible behind workspaces in the overview.
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// --- Startup (counterpart of dotfiles/sway/guix-autostart.in) -------------

// niri --session already pushes WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP
// XDG_SESSION_TYPE NIRI_SOCKET to D-Bus; this adds XDG_DATA_DIRS (flatpak
// exports) like the sway session does.
spawn-at-startup "@{dbus-update-activation-environment}" "WAYLAND_DISPLAY" "NIRI_SOCKET" "XDG_CURRENT_DESKTOP" "XDG_SESSION_TYPE" "DISPLAY" "XDG_DATA_DIRS"

// The shell: bar, launcher, notifications, OSD, wallpaper.
spawn-at-startup "@{noctalia}"

// Polkit authentication agent (noctalia's own is left off).
spawn-at-startup "@{lxqt-policykit-agent}"

// Automount removable media; --notify goes to noctalia's notification server.
spawn-at-startup "@{udiskie}" "--automount" "--notify" "--no-tray"

// Clipboard history, same single persistent wl-paste stream as under sway.
spawn-at-startup "@{wl-paste}" "-t" "text" "--watch" "@{clipman}" "store" "--no-persist"

// Fastfetch desktop overlays (layer-shell, bottom layer, by connector name).
spawn-at-startup "@{eww}" "open" "fastfetch-hdmi-a-3"
spawn-at-startup "@{eww}" "open" "fastfetch-dp-4"

// Lock before every suspend with porter; see the sway autostart for why -w.
spawn-at-startup "@{swayidle}" "-w" "before-sleep" "@{porter} lock -f"

// --- Key bindings (mirroring dotfiles/sway/config where niri has an analogue)

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+D hotkey-overlay-title="Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Shift+D hotkey-overlay-title="wmenu-run" { spawn "wmenu-run"; }
    Mod+Shift+V hotkey-overlay-title="Clipboard history" { spawn-sh "clipman pick --tool=CUSTOM --tool-args='wmenu -l 10'"; }
    Mod+N hotkey-overlay-title="Notifications" { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Escape hotkey-overlay-title="Session menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+Escape hotkey-overlay-title="powermenu (wmenu)" { spawn "powermenu"; }

    // Volume / media, usable while porter has the screen locked.
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioStop  allow-when-locked=true { spawn "playerctl" "stop"; }

    // Screenshots (saved to screenshot-path and copied to the clipboard).
    Print           { screenshot-screen; }
    Mod+Print       { screenshot; }          // interactive region picker
    Mod+Shift+Print { screenshot-window; }

    Mod+Shift+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }

    // Focus: columns left/right, windows within a column down/up.
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    Mod+Home       { focus-column-first; }
    Mod+End        { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    // Monitors (Dell left, Acer right).
    Mod+Ctrl+Left        { focus-monitor-left; }
    Mod+Ctrl+Right       { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Workspaces are dynamic and per-monitor; indices count from the top.
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Columns (niri's analogue of sway's splits / tabbed / resize mode).
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Shift+Space { toggle-window-floating; }
    Mod+Space       { switch-focus-between-floating-and-tiling; }

    // Escape hatch for apps that inhibit shortcuts (VMs, remote desktops).
    Mod+Shift+I allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // niri shows its own confirmation, like sway's swaynag prompt.
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
