# Generated by Guix Home from dotfiles/sway/guix-autostart.in.
# Tokens of the form at-sign brace NAME brace are substituted with absolute
# store paths at build time; see substituted-file in (ejyager00 home template).

# Push the Wayland session into the D-Bus activation environment.  home-dbus
# starts before sway, so activated services (portals) otherwise inherit an env
# with no WAYLAND_DISPLAY and fail.  Must precede everything else.
exec @{dbus-update-activation-environment} WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DISPLAY XAUTHORITY XDG_DATA_DIRS

# Polkit authentication agent.  Without this, anything invoking polkit (udisks
# mounts, NM system connections) fails with no visible prompt.
exec @{lxqt-policykit-agent}

# Notification daemon; D-Bus-activatable but exec'd so it inherits
# WAYLAND_DISPLAY at a predictable point.
exec @{swaync}

# Declarative output management, keyed on EDID.
exec @{kanshi}

# Clipboard history.  clipman consumes a single persistent wl-paste stream
# rather than spawning per selection event, which avoids the MIME-negotiation
# race that corrupts Firefox-family selections.
exec @{wl-paste} -t text --watch @{clipman} store --no-persist