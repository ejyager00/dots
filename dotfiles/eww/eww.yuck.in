;; ~/.dots/dotfiles/eww/eww.yuck
;; Generated by Guix Home from dotfiles/eww/eww.yuck.in.  Tokens of the form
;; at-sign brace NAME brace are substituted with absolute store paths at
;; build time; see substituted-file in (ejyager00 home template).
;;
;; Fastfetch overlay. Pinned to the wlr-layer-shell "bottom" layer, which
;; renders above swaybg's "background" layer but stays below ordinary
;; application windows -- so it reads as part of the desktop, not a window.
;; :focusable "none" and :exclusive false keep it out of the way of input
;; and tiling layout.

(defpoll fastfetch_output
  :interval "30s"
  "@{fastfetch} --pipe false -l guix -s title:separator:os:kernel:uptime:packages:cpu:gpu:memory:disk 2>/dev/null | @{python3} @{ansi2pango}")

(defwidget fastfetch-widget []
  (box :class "fastfetch-box"
       :orientation "v"
       :space-evenly false
    (label :class "fastfetch-label"
           :halign "start"
           :wrap false
           :markup fastfetch_output)))

(defwindow fastfetch-hdmi-a-3
  :monitor "HDMI-A-3"
  :geometry (geometry
              :x "24px"
              :y "24px"
              :width "700px"
              :height "242px"
              :anchor "top right")
  :stacking "bottom"
  :exclusive false
  :focusable "none"
  :namespace "fastfetch-widget"
  (fastfetch-widget))

(defwindow fastfetch-dp-4
  :monitor "DP-4"
  :geometry (geometry
              :x "24px"
              :y "24px"
              :width "700px"
              :height "242px"
              :anchor "top right")
  :stacking "bottom"
  :exclusive false
  :focusable "none"
  :namespace "fastfetch-widget"
  (fastfetch-widget))
