HISTFILE="$HOME/.local/state/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_VERIFY

autoload -Uz vcs_info
setopt PROMPT_SUBST
zstyle ':vcs_info:git:*' formats ' (%b)'
precmd() { vcs_info }
PROMPT='%F{cyan}%~%f${vcs_info_msg_0_}%# '

# pinentry needs to know which terminal to talk to when it falls back to the
# curses backend (no Wayland/X display, e.g. a TTY or an ssh session).
export GPG_TTY=$TTY

# The agent itself is a Shepherd service on a fixed socket (see
# home-config.scm); keychain inherits it rather than spawning its own, and
# just makes sure the key is loaded.
eval $(keychain --eval --quiet id_ed25519)

# Project secrets live in that project's .envrc (via `pass` + the direnv hook
# below), not here -- a `pass show` at this level makes every new terminal
# block on a pinentry prompt regardless of what you're actually doing.

eval "$(direnv hook zsh)"